# Default: local accounts + persistent SQLite. Node.js 24+ required.
APP_STORAGE=local
# Optional absolute path on a persistent disk. Default: ./data/shunshoupai.sqlite
# APP_DB_PATH=/var/lib/shunshoupai/app.sqlite

# Optional OpenAI-compatible Chat Completions API. Keep API keys server-only.
# Without AI_API_KEY the app explicitly uses the limited Chinese rules parser.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Daily parse quota per account (UTC day; clamped to 1..100).
AI_DAILY_LIMIT=50

# Personal model API keys are AES-256-GCM encrypted on the server.
# Required for Supabase or multi-instance deployments: a Base64-encoded random 32-byte key.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and back it up. Losing/changing it makes saved personal keys unreadable.
MODEL_SETTINGS_ENCRYPTION_KEY=
# Local mode automatically creates model-encryption.key beside APP_DB_PATH when unset.
# Back up this private file together with the SQLite database; never commit it.
# Optional exact-host allowlist for self-hosted/private model endpoints (default: public HTTPS only).
# AI_ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# Cloud mode: set APP_STORAGE=supabase and run supabase/migrations/*.sql first.
# Use the public anon/publishable project key, NEVER a service_role/admin key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set the deployed https origin behind a reverse proxy, e.g. https://your-domain.com
# APP_ORIGIN=https://your-domain.com
# Required for production HTTPS cookie transport. Keep false for local HTTP/LAN demos.
COOKIE_SECURE=false
