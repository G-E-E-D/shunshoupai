# Local-first devices + persistent SQLite. No registration or cloud accounts.
# Node.js 24+ required. The installed desktop sets a fresh bootstrap secret automatically.
APP_STORAGE=local
# Optional absolute path on a persistent disk. Default: ./data/shunshoupai.sqlite
# APP_DB_PATH=/var/lib/shunshoupai/app.sqlite
# Source development only: generate a random secret of at least 32 characters,
# and pass it only to your local Node process and the local Qt --backend process.
# Never use a sample/default value, expose it to a browser, or commit it.
# APP_DEVICE_BOOTSTRAP_KEY=

# Optional OpenAI-compatible Chat Completions API. Keep API keys server-only.
# Without AI_API_KEY the app explicitly uses the limited Chinese rules parser.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Daily parse quota per local calendar (UTC day; clamped to 1..100).
AI_DAILY_LIMIT=50

# Personal model API keys are AES-256-GCM encrypted on the local computer.
# Optional explicit master key: a Base64-encoded random 32-byte key.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and back it up. Losing/changing it makes saved personal keys unreadable.
MODEL_SETTINGS_ENCRYPTION_KEY=
# Local mode automatically creates model-encryption.key beside APP_DB_PATH when unset.
# Back up this private file together with the SQLite database; never commit it.
# Optional exact-host allowlist for self-hosted/private model endpoints (default: public HTTPS only).
# AI_ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# v2 does not use Supabase. Export old cloud data before migrating to local storage.
# Leave APP_ORIGIN unset for the desktop's loopback and trusted LAN addresses.
# If you add HTTPS transport, enable secure cookies too.
COOKIE_SECURE=false
