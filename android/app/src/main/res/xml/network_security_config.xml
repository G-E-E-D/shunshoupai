<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The user can explicitly choose an HTTP LAN server. Public deployments should use HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
