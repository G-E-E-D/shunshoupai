<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <ScrollView android:id="@+id/setup_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="28dp" android:paddingBottom="32dp">
            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/setup_calendar" android:importantForAccessibility="no" android:layout_marginBottom="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_eyebrow" android:textColor="@color/accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_title" android:textColor="@color/ink" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_description" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="5dp" android:layout_marginBottom="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel_background">
                <TextView android:id="@+id/paired_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_unpaired" android:textColor="@color/ink" android:textSize="15sp" android:layout_marginBottom="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/server_label" android:textColor="@color/ink" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="10dp" />
                <EditText android:id="@+id/server_url" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/input_background" android:hint="@string/server_placeholder" android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo" android:autofillHints="" android:importantForAutofill="no" android:maxLength="2048" android:textColor="@color/ink" android:textColorHint="#80868B" android:textSize="15sp" android:paddingHorizontal="14dp" android:paddingVertical="14dp" android:selectAllOnFocus="true" />
                <TextView android:id="@+id/connection_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#B3261E" android:textSize="12sp" android:lineSpacingExtra="4dp" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/scan_button" style="@style/ModernActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/scan_connect" />
                <Button android:id="@+id/paste_pairing_link" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="粘贴配对链接" />
                <Button android:id="@+id/show_pairing_code" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/show_pairing_code" />
                <Button android:id="@+id/connect_button" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/connect" />
                <Button android:id="@+id/unpair_device" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/unpair_device" android:visibility="gone" />
                <LinearLayout android:id="@+id/peer_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <Button android:id="@+id/local_spaces" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/local_spaces" android:visibility="gone" />
                <Button android:id="@+id/cancel_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:visibility="gone" style="?android:attr/borderlessButtonStyle" android:text="@string/cancel_connection_edit" android:textColor="@color/accent" android:textAllCaps="false" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_help_title" android:textColor="@color/ink" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_steps" android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="7dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_network_note" android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="5dp" android:layout_marginTop="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_limits" android:textColor="#80868B" android:textSize="11sp" android:lineSpacingExtra="5dp" android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/web_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:background="@color/background" android:orientation="horizontal">
            <ImageButton android:id="@+id/toolbar_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="@string/toolbar_back" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/toolbar_title" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" />
                <TextView android:id="@+id/server_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/muted" android:layout_marginTop="2dp" />
            </LinearLayout>
            <ImageButton android:id="@+id/toolbar_refresh" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_refresh" android:contentDescription="@string/toolbar_refresh" />
            <ImageButton android:id="@+id/toolbar_settings" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" android:contentDescription="@string/toolbar_settings" />
        </LinearLayout>
        <ProgressBar android:id="@+id/loading_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:progressTint="@color/accent" android:progressBackgroundTint="@color/tonal" android:visibility="gone" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <WebView android:id="@+id/web_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" />
            <LinearLayout android:id="@+id/loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="@color/background" android:visibility="gone">
                <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/setup_calendar" android:importantForAccessibility="no" android:layout_marginBottom="24dp" />
                <ProgressBar android:layout_width="28dp" android:layout_height="28dp" android:indeterminateTint="@color/accent" android:importantForAccessibility="no" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loading_workspace" android:textColor="@color/ink" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loading_workspace_note" android:textColor="@color/muted" android:textSize="13sp" android:lineSpacingExtra="5dp" android:gravity="center" android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/error_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="@color/background" android:visibility="gone">
                <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/setup_calendar" android:importantForAccessibility="no" android:layout_marginBottom="24dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_title" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:gravity="center" />
                <TextView android:id="@+id/error_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_default" android:textSize="14sp" android:lineSpacingExtra="6dp" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/error_retry" style="@style/ModernActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:layout_marginTop="28dp" />
                <Button android:id="@+id/error_offline" style="@style/ModernTonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back_offline" android:layout_marginTop="8dp" />
                <Button android:id="@+id/error_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" style="?android:attr/borderlessButtonStyle" android:text="@string/edit_server" android:textAllCaps="false" android:textColor="@color/accent" android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
