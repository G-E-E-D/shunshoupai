<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView android:id="@+id/setup_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" android:layout_marginBottom="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_eyebrow" android:textColor="@color/accent" android:textSize="12sp" android:letterSpacing="0.08" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_title" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_description" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="5dp" android:layout_marginBottom="25dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel_background">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_label" android:textColor="@color/ink" android:textSize="13sp" android:layout_marginBottom="10dp" />
                <EditText android:id="@+id/server_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/input_background" android:hint="@string/server_placeholder" android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo" android:autofillHints="" android:importantForAutofill="no" android:maxLength="2048" android:textColor="@color/ink" android:textColorHint="#969DA8" android:textSize="14sp" android:paddingHorizontal="13dp" android:paddingVertical="12dp" android:selectAllOnFocus="true" />
                <TextView android:id="@+id/connection_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#B16D5B" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/connect_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:background="@drawable/button_background" android:backgroundTint="@null" android:text="@string/connect" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:paddingHorizontal="10dp" android:paddingVertical="13dp" />
                <Button android:id="@+id/scan_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" style="?android:attr/borderlessButtonStyle" android:text="@string/scan_connect" android:textColor="@color/accent" android:textAllCaps="false" android:textSize="14sp" android:drawableStart="@drawable/ic_qr" android:drawablePadding="8dp" android:paddingHorizontal="15dp" />
                <Button android:id="@+id/cancel_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:visibility="gone" style="?android:attr/borderlessButtonStyle" android:text="@string/cancel_connection_edit" android:textColor="@color/muted" android:textAllCaps="false" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_help_title" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="26dp" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_steps" android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_network_note" android:textColor="@color/muted" android:textSize="11sp" android:lineSpacingExtra="4dp" android:layout_marginTop="13dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_limits" android:textColor="#8D95A1" android:textSize="11sp" android:lineSpacingExtra="4dp" android:layout_marginTop="22dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/web_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="4dp" android:gravity="center_vertical" android:background="#FFFFFF" android:orientation="horizontal">
            <ImageButton android:id="@+id/toolbar_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="@string/toolbar_back" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="3dp" android:paddingVertical="7dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/toolbar_title" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink" />
                <TextView android:id="@+id/server_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/muted" android:layout_marginTop="2dp" />
            </LinearLayout>
            <ImageButton android:id="@+id/toolbar_refresh" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_refresh" android:contentDescription="@string/toolbar_refresh" />
            <ImageButton android:id="@+id/toolbar_settings" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" android:contentDescription="@string/toolbar_settings" />
        </LinearLayout>
        <ProgressBar android:id="@+id/loading_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:progressTint="@color/accent" android:progressBackgroundTint="#F9E5DE" android:visibility="gone" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <WebView android:id="@+id/web_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" />
            <LinearLayout android:id="@+id/error_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="@color/background" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" android:gravity="center" />
                <TextView android:id="@+id/error_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_default" android:textSize="14sp" android:lineSpacingExtra="6dp" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/error_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/button_background" android:backgroundTint="@null" android:text="@string/retry" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="26dp" android:paddingVertical="13dp" />
                <Button android:id="@+id/error_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" style="?android:attr/borderlessButtonStyle" android:text="@string/edit_server" android:textAllCaps="false" android:textColor="@color/muted" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
